{
  "name": "quadrics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "scripts"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "uploads:reconcile": "node scripts/reconcile-uploads.mjs --local",
    "uploads:reconcile:remote": "node scripts/reconcile-uploads.mjs --remote",
    "uploads:prune": "node scripts/prune-upload-sessions.mjs --local",
    "uploads:prune:remote": "node scripts/prune-upload-sessions.mjs --remote",
    "photos:cleanup:deletions": "node scripts/cleanup-photo-deletions.mjs --local",
    "photos:cleanup:deletions:remote": "node scripts/cleanup-photo-deletions.mjs --remote",
    "images:process": "node scripts/process-images.mjs --local",
    "images:process:remote": "node scripts/process-images.mjs --remote",
    "notifications:deliver": "node scripts/deliver-gallery-notifications.mjs",
    "notifications:watch": "node scripts/watch-gallery-notifications.mjs",
    "downloads:prune": "node scripts/prune-download-events.mjs --local",
    "downloads:prune:remote": "node scripts/prune-download-events.mjs --remote",
    "gallery:rate-limits:prune": "node scripts/prune-gallery-share-image-rate-limits.mjs --local",
    "gallery:rate-limits:prune:remote": "node scripts/prune-gallery-share-image-rate-limits.mjs --remote",
    "backup:local": "node scripts/backup-local.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore-check": "node scripts/restore-check-local.mjs",
    "backup:restore-e2e": "node scripts/restore-check-local.mjs --e2e",
    "health:check": "node scripts/check-readiness.mjs",
    "maintenance": "node scripts/run-maintenance.mjs",
    "storage:audit": "node scripts/audit-storage.mjs",
    "storage:cleanup": "node scripts/cleanup-storage-orphans.mjs",
    "db:start": "supabase start -x realtime,imgproxy,studio,edge-runtime,logflare,vector,supavisor,postgres-meta && supabase seed buckets --local",
    "db:seed": "supabase seed buckets --local",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
