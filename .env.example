# Copie para .env.local. Use a URL e a chave pública exibidas por supabase status.
# Variáveis QUADRICS_* têm prioridade. Configurações existentes com CARTLIO_* continuam aceitas.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: hostname direto do Storage para uploads grandes em ambiente hospedado.
# Exemplo: https://<project-ref>.storage.supabase.co. Vazio usa NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_STORAGE_URL=
# Em Docker, use http://host.docker.internal:54321 na URL acima.
# QUADRICS_DOCKER_SUPABASE_URL=http://host.docker.internal:54321
# Somente no servidor Next: necessária para servir previews de links compartilhados.
# Nunca use NEXT_PUBLIC_ neste nome ou inclua a chave em código enviado ao navegador.
SUPABASE_SERVER_SECRET_KEY=
# Em produção, obrigatório. O proxy deve sobrescrever este cabeçalho com um único IP válido do cliente.
# Opções: cf-connecting-ip, x-real-ip ou x-forwarded-for. O modo local não exige configuração.
# QUADRICS_TRUSTED_CLIENT_IP_HEADER=x-real-ip
# SMTP opcional no desenvolvimento (use o Mailpit incluído); obrigatório no container de produção.
# QUADRICS_SMTP_HOST=
# QUADRICS_SMTP_PORT=587
# QUADRICS_SMTP_SECURE=false
# QUADRICS_SMTP_REQUIRE_TLS=true
# QUADRICS_SMTP_USER=
# QUADRICS_SMTP_PASSWORD=
# QUADRICS_SMTP_FROM=Quadrics <notificacoes@seudominio.com>
# URL pública canônica usada em links de autenticação, previews e notificações.
# Obrigatória em produção e deve usar HTTPS. Em Docker local, use http://localhost:3000.
QUADRICS_APP_URL=
# Hostname sem protocolo, usado pelo Caddy no Compose de produção.
# QUADRICS_HOST=app.seudominio.com.br
# Configuração reservada para o armazenamento de originais no R2.
# Deixe vazia enquanto a integração estiver desativada.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
